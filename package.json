{
  "name": "samdub",
  "productName": "samDub",
  "version": "0.5.0",
  "description": "samDub — a focused desktop workstation for live dub performance",
  "private": true,
  "author": "Sam Taylor",
  "homepage": "https://sam.taylor.org.uk/samDub/",
  "main": "main.js",
  "scripts": {
    "setup-electron": "npx --yes node@22.12.0 node_modules/electron/install.js",
    "start": "electron .",
    "dist:win": "npx --yes node@22.12.0 node_modules/electron-builder/cli.js --win nsis --x64",
    "dist:mac:intel": "npx --yes node@22.12.0 node_modules/electron-builder/cli.js --mac dmg zip --x64"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "music-metadata": "^11.14.0"
  },
  "build": {
    "appId": "uk.org.taylor.samdub",
    "productName": "samDub",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "samDub-${version}-windows-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "samDub",
      "uninstallDisplayName": "samDub"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "artifactName": "samDub-${version}-macos-intel.${ext}",
      "identity": null,
      "hardenedRuntime": false
    }
  }
}
